[Unit]
Description=Focus Room Django application
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/vepo.in
Environment=DJANGO_SECRET_KEY=replace-with-a-long-random-value
Environment=DJANGO_DEBUG=0
Environment=DJANGO_HTTPS=0
ExecStart=/var/www/vepo.in/.venv/bin/gunicorn focusroom.wsgi:application --bind 127.0.0.1:8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target